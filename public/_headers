# Cabeçalhos de segurança e cache dos arquivos estáticos (Cloudflare Workers Static Assets).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data: https://cards.scryfall.io; font-src 'self'; connect-src 'self' https://cards.scryfall.io https://cloudflareinsights.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/modelos/*
  Cache-Control: public, max-age=31536000, immutable
