// Configuração do Cloudflare Worker do Proxinho.
// Um único Worker serve o site (arquivos estáticos do Vite) e a API em /api/*.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "proxinho",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "proxinho",
      "database_id": "4dfcb764-41d3-410b-a0f1-8a0af759dd21",
      "migrations_dir": "migrations",
    },
  ],
  "routes": [{ "pattern": "proxinho.johnlaff.com", "custom_domain": true }],
}
