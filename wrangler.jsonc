// Configuração do Cloudflare Worker do Proxinho.
// Um único Worker serve o site (arquivos estáticos do Vite) e a API em /api/*.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "proxinho",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "proxinho",
      "database_id": "4dfcb764-41d3-410b-a0f1-8a0af759dd21",
      "migrations_dir": "migrations",
    },
  ],
  // Fontes das cartas reais (Beleren e MPlantin). Os arquivos ficam só aqui,
  // fora do repositório público; ver docs/adr/0001-motor-da-carta-no-navegador.md.
  "kv_namespaces": [{ "binding": "FONTES", "id": "45bd871710cf4290a73b902f3b54a6d8" }],
  // Cartas montadas de antemão pelo mesmo motor do site (ADR 0022): depósito privado, servido
  // só pelo Worker em /api/cartas/. Grava o workflow da montagem deste repositório no GitHub, sem
  // senha (token OIDC conferido em worker/github.ts, pelos números do repositório e do dono), ou
  // quem tiver o segredo CARTAS_TOKEN (o montador rodado à mão).
  "r2_buckets": [{ "binding": "CARTAS", "bucket_name": "proxinho-cartas" }],
  "vars": { "MONTAGEM_REPO_ID": "1460874607", "MONTAGEM_DONO_ID": "46091881" },
  "routes": [{ "pattern": "proxinho.johnlaff.com", "custom_domain": true }],
}
